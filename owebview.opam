# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "OCaml 5 and Eio desktop application runtime"
description: """
An opinionated OCaml 5 desktop application runtime built on the system WebView. It provides managed native handles, an Eio lifecycle, a shared native/js_of_ocaml protocol, typed RPC, bounded realtime streams, secure application assets, multiple windows, and durable shared sessions.

On macOS the native dependencies are provided by Cocoa/WebKit. Linux discovery prefers GTK4/WebKitGTK 6.0 and falls back to GTK3/WebKitGTK 4.1 or 4.0. Windows targets use the upstream WebView2 backend but remain unvalidated."""
maintainer: ["Dakota Murphy <dakotamurphyucf@gmail.com>"]
authors: ["Frédéric Lang" "Dakota Murphy"]
license: "MIT"
homepage: "https://github.com/dakotamurphyucf/owebview-runtime"
bug-reports: "https://github.com/dakotamurphyucf/owebview-runtime/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.3"}
  "eio" {>= "1.3"}
  "eio_main" {>= "1.3"}
  "cohttp-eio" {>= "6.0"}
  "magic-mime" {>= "1.3"}
  "uri" {>= "4.4"}
  "yojson" {>= "3.0"}
  "js_of_ocaml" {>= "6.4"}
  "dune-configurator" {>= "3.0" & build}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/dakotamurphyucf/owebview-runtime.git"
depexts: [
  ["libgtk-3-dev" "libwebkit2gtk-4.1-dev"] {os-family = "debian"}
  ["gtk3-devel" "webkit2gtk4.1-devel"] {os-family = "fedora" | os-family = "rhel"}
  ["gtk3" "webkit2gtk-4.1"] {os-family = "arch"}
  ["gtk+3.0-dev" "webkit2gtk-4.1-dev"] {os-distribution = "alpine"}
]
